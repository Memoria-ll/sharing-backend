rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // キャラクターデータコレクションのルール
    match /characterData/{docId} {
      // 共有データの読み取り・書き込みは Cloud Functions 経由に限定する。
      // Firebase Admin SDK を使う Cloud Functions はこのルールの影響を受けない。
      allow read, write: if false;
    }
  }
}
